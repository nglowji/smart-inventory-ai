# Local development sample, never production credentials.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=smartinventory
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://inventory:local-dev-only@127.0.0.1:5432/smartinventory
DB_CONNECT_TIMEOUT=3
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ACCESS_TOKEN_MINUTES=30
# Generate JWT_SECRET locally, at least 32 random characters.
# Optional ADMIN_EMAIL / ADMIN_PASSWORD for first admin seed; seed can also prompt.
